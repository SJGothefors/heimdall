{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Heimdall in iPhone simulator",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/Scripts/run_simulator.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Run Heimdall with device authentication",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/Scripts/run_simulator.py", "--authenticate"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
